# ==========================================
# MediSense .gitignore
# ==========================================

# Compiled Java class files
*.class

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Frontend / Node
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo

# Python / Reranker
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.Python
env/
venv/
.venv/
reranker-service/venv/
reranker-service/.venv/

# Environment variables & secrets
.env
*.env
!.env.example
!frontend/.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# IDEs and Editors
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
*.sublime-workspace
*.sublime-project

# OS Generated Files
.DS_Store
Thumbs.db
Desktop.ini

# Logs & Temporary files
logs/
*.log
scratch/
tmp/
