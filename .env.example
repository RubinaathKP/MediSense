# ===================================================================
# MediSense Production & Development Environment Configuration
# Copy this file to .env and provide secrets before starting the system.
# ===================================================================

# -------------------------------------------------------------------
# Database Credentials (PostgreSQL with pgvector)
# -------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=medisense
DB_USERNAME=medisense_user
DB_PASSWORD=your_secure_postgres_password_here
DB_URL=jdbc:postgresql://postgres:5432/medisense

# -------------------------------------------------------------------
# Redis Caching & Token Blacklist
# -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379

# -------------------------------------------------------------------
# JWT Security & Asymmetric RSA Keys (RS256)
# Generate via: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# -------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# -------------------------------------------------------------------
# LLM Provider Keys (Google Gemini & Ollama Fallback)
# -------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
OLLAMA_URL=http://ollama:11434

# -------------------------------------------------------------------
# Indic Language Translation (Sarvam AI)
# -------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_ai_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# -------------------------------------------------------------------
# ABDM (Ayushman Bharat Digital Mission) Sandbox Credentials
# Register at sandbox.abdm.gov.in to obtain Sandbox Client ID & Secret
# -------------------------------------------------------------------
ABDM_CLIENT_ID=your_abdm_client_id_here
ABDM_CLIENT_SECRET=your_abdm_client_secret_here
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_HIU_ID=your_registered_hiu_id

# -------------------------------------------------------------------
# Cross-Encoder Reranker Microservice
# -------------------------------------------------------------------
RERANKER_URL=http://reranker:8001

# -------------------------------------------------------------------
# Frontend & CORS Configuration
# -------------------------------------------------------------------
REACT_APP_FRONTEND_URL=http://localhost:3000,http://localhost:5173
API_BASE_URL=/api/v1
